# MongoDB Connection URI
# Replace with your actual MongoDB connection string
# For local: mongodb://localhost:27017/taskflow
# For Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority
MONGO_URI=

# JWT Secret Key
# Use a strong random string (e.g., openssl rand -hex 32)
JWT_SECRET=

# Server Port (default: 5000)
PORT=5000

# Frontend Client URL (for CORS)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
# Multiple origins: comma-separated
CLIENT_URL=http://localhost:5173