# ============================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
client/.env
server/.env

# Keep .env.example tracked (explicitly not ignored)
!.env.example
!server/.env.example
!client/.env.example

# ============================
